extends SceneTree
## Drafts the shipped default world database with the world generator:
##
##   <godot> --headless --path . --script res://tools/build_default_database.gd
##
## Writes res://data/databases/default.f2fdb. The result is a generated **draft**; the curated
## default is authored in the Database Editor (see docs/ROADMAP.md). Re-run after changing the
## generator — the career database tests fail while the shipped file is out of date.

const DEFAULT_SEED: int = 20261115
const DATABASE_ID: String = "f2f_default"
const NAME: String = "Frag to Fame — Default World"
const DESCRIPTION: String = "Development draft generated by the world generator: 40 original organisations " \
	+ "across 4 tiers and 8 regions, 296 professionals and their competitions. To be curated in the Database Editor."
const WORK_PATH: String = "user://cache/build/default.f2fdb"


func _initialize() -> void:
	var error := WorldGenerator.build(WORK_PATH, DEFAULT_SEED, DATABASE_ID, NAME, DESCRIPTION)
	if error.is_empty():
		var world := WorldDatabase.new()
		error = world.open(WORK_PATH)
		if error.is_empty():
			var problems := world.validate()
			error = "; ".join(problems) if not problems.is_empty() else world.export_to(WorldDatabases.default_path())
			print("Default database: %s organisations, %s players, %s competitions, fingerprint %s" % [
				world.organisation_count(), world.player_count(), world.competition_count(), world.fingerprint()])
		world.close()
	if error.is_empty():
		print("Wrote %s" % WorldDatabases.default_path())
	else:
		printerr("Building the default database failed: %s" % error)
	quit(0 if error.is_empty() else 1)
